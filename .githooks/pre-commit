#!/usr/bin/env bash
# pre-commit hook — Farm-Grind/claude-skills
# Runs scope inflation gate and corpus ceiling check before every commit.
# Install: git config core.hooksPath .githooks

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

EXIT=0

# ── Scope inflation gate (P-15 STRUCTURAL fix) ────────────────────────────────
# Only fires when ci/scope-active.json exists (manifested tasks).
# WARN (exit 2) when no manifest — allows unmanifested commits through.
if python3 ci/check_scope_inflation.py --check --staged; then
    : # PASS
else
    CODE=$?
    if [ "$CODE" -eq 1 ]; then
        echo ""
        echo "COMMIT BLOCKED — scope inflation gate FAIL (P-15)"
        echo "  Revert out-of-scope changes or re-declare scope with --init."
        EXIT=1
    fi
    # exit 2 (WARN / no manifest) — allow through
fi

# ── Skill publisher gate check (F-035 STRUCTURAL fix) ────────────────────────
# Blocks commits modifying skills/*/SKILL.md where gates_passed date is stale.
# A stale date means skill-publisher Gate 9 was not run (direct bypass detected).
# WARN (exit 2) when no modified skill files staged — allows non-skill commits through.
if python3 ci/check_skill_gate.py; then
    : # PASS
else
    CODE=$?
    if [ "$CODE" -eq 1 ]; then
        echo ""
        echo "COMMIT BLOCKED — skill publisher gate bypass detected (P-12 / F-035)"
        echo "  Run skill-publisher gate sequence before committing SKILL.md changes."
        EXIT=1
    fi
    # exit 2 (WARN / no modified skill files) — allow through
fi

# ── Corpus ceiling check ──────────────────────────────────────────────────────
if python3 ci/check_ceiling.py; then
    : # PASS
else
    echo ""
    echo "COMMIT BLOCKED — corpus ceiling exceeded"
    EXIT=1
fi

exit $EXIT
